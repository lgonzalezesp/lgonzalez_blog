---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
	/** Only active on an exact match (home links), instead of on any page below `href`. */
	exact?: boolean;
};

const { href, class: className, exact = false, ...props } = Astro.props;
const pathname = Astro.url.pathname;
const target = String(href);
const isCurrent = pathname === target;
const isActive = isCurrent || (!exact && pathname.startsWith(target));
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	aria-current={isCurrent ? 'page' : undefined}
	{...props}
>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
