---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import OgDefault from '../assets/og-default.png';
import { type Alternates, feedUrl } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { buildMeta, type MetaInput, type OgImage } from '../lib/seo';

interface Props {
	title: string;
	description: string;
	/** Cover of the content; cropped to 1200×627 for social networks. */
	image?: { src: ImageMetadata; alt: string };
	lang: Lang;
	alternates: Alternates;
	article?: MetaInput['article'];
	noindex?: boolean;
}

const { title, description, image, lang, alternates, article, noindex } = Astro.props;
const t = useTranslations(lang);

const OG_SIZE = { width: 1200, height: 627 };
async function ogImage(src: ImageMetadata, alt: string, format: 'jpg' | 'png'): Promise<OgImage> {
	const result = await getImage({ src, ...OG_SIZE, fit: 'cover', format });
	return { src: result.src, ...OG_SIZE, alt };
}

const meta = buildMeta({
	site: Astro.site!,
	path: Astro.url.pathname,
	title,
	description,
	lang,
	alternates,
	image: image && (await ogImage(image.src, image.alt, 'jpg')),
	defaultImage: await ogImage(OgDefault, t('og.defaultAlt'), 'png'),
	article,
	noindex,
});
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={t('feed.title')}
	href={new URL(feedUrl(lang), Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={meta.canonical} />
{meta.alternateLinks.map((alt) => (
	<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}
{meta.tags.map((tag) =>
	tag.property ? (
		<meta property={tag.property} content={tag.content} />
	) : (
		<meta name={tag.name} content={tag.content} />
	),
)}
