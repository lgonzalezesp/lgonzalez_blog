---
import { SITE_TITLE } from '../consts';
import { type Alternates, type Section, sectionUrl } from '../i18n/routes';
import type { Lang, UiKey } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import HeaderLink from './HeaderLink.astro';
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	lang: Lang;
	alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);

const links: { section: Section; label: UiKey }[] = [
	{ section: 'home', label: 'nav.home' },
	{ section: 'blog', label: 'nav.blog' },
	{ section: 'projects', label: 'nav.projects' },
	{ section: 'notes', label: 'nav.notes' },
	{ section: 'about', label: 'nav.about' },
];
---

<header class="border-b border-border">
	<!-- On narrow screens the links wrap onto several lines: no dropdown, no JS. -->
	<div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3">
		<a href={sectionUrl('home', lang)} class="font-bold text-fg no-underline">
			{SITE_TITLE}
		</a>
		<nav aria-label={t('nav.label')}>
			<ul class="flex flex-wrap gap-x-4 gap-y-1">
				{links.map(({ section, label }) => (
					<li>
						<HeaderLink href={sectionUrl(section, lang)} exact={section === 'home'}>
							{t(label)}
						</HeaderLink>
					</li>
				))}
			</ul>
		</nav>
		<div class="flex items-center gap-3">
			<LanguagePicker lang={lang} alternates={alternates} />
			<ThemeToggle lang={lang} />
		</div>
	</div>
</header>
