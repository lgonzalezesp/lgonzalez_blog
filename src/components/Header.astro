---
import { SITE_TITLE } from '../consts';
import { type Alternates, sectionUrl } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import HeaderLink from './HeaderLink.astro';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
	lang: Lang;
	alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
---

<header>
	<nav aria-label={t('nav.label')}>
		<p class="site-title">
			<a href={sectionUrl('home', lang)}>{SITE_TITLE}</a>
		</p>
		<div class="internal-links">
			<HeaderLink href={sectionUrl('home', lang)} exact>
				{t('nav.home')}
			</HeaderLink>
			<HeaderLink href={sectionUrl('blog', lang)}>{t('nav.blog')}</HeaderLink>
			<HeaderLink href={sectionUrl('about', lang)}>{t('nav.about')}</HeaderLink>
		</div>
		<LanguagePicker lang={lang} alternates={alternates} />
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	.site-title {
		margin: 0;
		font-size: 1em;
		font-weight: bold;
	}
	.site-title a {
		text-decoration: none;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
