---
import { getTagGroups } from '../../lib/collections';
import TagView from '../../views/TagView.astro';

export async function getStaticPaths() {
	const others = await getTagGroups('en');
	return (await getTagGroups('es')).map((group) => {
		const other = others.find((candidate) => candidate.slug === group.slug);
		return {
			params: { tag: group.slug },
			props: { group, alternate: other && { lang: 'en' as const, label: other.label } },
		};
	});
}

const { group, alternate } = Astro.props;
---

<TagView lang="es" group={group} alternate={alternate} />
