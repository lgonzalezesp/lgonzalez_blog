---
import Pagination from '../components/Pagination.astro';
import PostCard from '../components/PostCard.astro';
import { BLOG_PAGE_SIZE, SITE_TITLE } from '../consts';
import { blogPageUrl } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import Base from '../layouts/Base.astro';
import { getPublished } from '../lib/collections';
import { getPage, paginate } from '../lib/pagination';

interface Props {
	lang: Lang;
	/** 1 for /blog/; 2…n for /blog/pagina/N/. */
	pageNumber?: number;
}

const { lang, pageNumber = 1 } = Astro.props;
const t = useTranslations(lang);
const pages = paginate(await getPublished('blog', lang), BLOG_PAGE_SIZE);
const page = getPage(pages, pageNumber);
if (!page) throw new Error(`La página ${pageNumber} del blog no existe (${lang}).`);

const other = lang === 'es' ? 'en' : 'es';
const otherPages = paginate(await getPublished('blog', other), BLOG_PAGE_SIZE);
const title = pageNumber === 1 ? t('blog.title') : t('blog.pageTitle', { page: pageNumber });
---

<Base
	title={`${title} | ${SITE_TITLE}`}
	description={t('blog.description')}
	lang={lang}
	alternates={{
		[lang]: blogPageUrl(pageNumber, lang),
		...(getPage(otherPages, pageNumber) && { [other]: blogPageUrl(pageNumber, other) }),
	}}
	width="wide"
>
	<header class="mb-10">
		<h1 class="text-3xl font-bold sm:text-4xl">{title}</h1>
		<p class="mt-2 text-muted">{t('blog.description')}</p>
	</header>
	{page.items.length === 0 && <p>{t('blog.empty')}</p>}
	<div class="grid gap-10 sm:grid-cols-2">
		{page.items.map((post) => (
			<PostCard post={post} lang={lang} />
		))}
	</div>
	<Pagination page={page} lang={lang} />
</Base>
