---
// Minimal home: the real design and content arrive with spec 004.
import { SITE_TITLE } from '../consts';
import { sectionAlternates, sectionUrl } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import Base from '../layouts/Base.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base title={SITE_TITLE} lang={lang} alternates={sectionAlternates('home')}>
	<h1>{SITE_TITLE}</h1>
	<p>{t('home.intro')}</p>
	<p>
		<a href={sectionUrl('blog', lang)}>{t('home.cta')}</a>
	</p>
</Base>
