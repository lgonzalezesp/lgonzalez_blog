---
// Shell of every page: language, head (with hreflang), header, main and footer.
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { Alternates } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
	lang: Lang;
	alternates: Alternates;
	mainClass?: string;
}

const { title, description, image, lang, alternates, mainClass } = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead
			title={title}
			description={description ?? t('site.description')}
			image={image}
			lang={lang}
			alternates={alternates}
		/>
	</head>
	<body>
		<Header lang={lang} alternates={alternates} />
		<main class={mainClass}>
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
