---
// Shell of every page: language, head (with hreflang), theme, header, main and footer.
import type { ImageMetadata } from 'astro';
import type { MetaInput } from '../lib/seo';
import Analytics from '../components/Analytics.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SkipLink from '../components/SkipLink.astro';
import type { Alternates } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	title: string;
	description?: string;
	/** Cover of the content, used for social networks (cropped to 1200×627). */
	image?: { src: ImageMetadata; alt: string };
	article?: MetaInput['article'];
	noindex?: boolean;
	lang: Lang;
	alternates: Alternates;
	/** `reading` for long-form text (narrow column), `wide` for listings and grids. */
	width?: 'reading' | 'wide';
	mainClass?: string;
}

const {
	title,
	description,
	image,
	article,
	noindex,
	lang,
	alternates,
	width = 'reading',
	mainClass,
} = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<!-- Apply the reader's saved theme before the first paint (see ThemeToggle.astro). -->
		<script is:inline>
			try {
				const theme = localStorage.getItem('theme');
				if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
			} catch {
				/* storage unavailable: follow the system preference */
			}
		</script>
		<BaseHead
			title={title}
			description={description ?? t('site.description')}
			image={image}
			article={article}
			noindex={noindex}
			lang={lang}
			alternates={alternates}
		/>
		<Analytics />
	</head>
	<body>
		<SkipLink lang={lang} />
		<Header lang={lang} alternates={alternates} />
		<main
			id="main"
			tabindex="-1"
			class:list={[
				'mx-auto w-full flex-1 px-4 py-10 focus:outline-none',
				width === 'wide' ? 'max-w-5xl' : 'max-w-3xl',
				mainClass,
			]}
		>
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
