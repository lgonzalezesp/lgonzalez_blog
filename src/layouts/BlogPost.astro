---
// Posts and notes. Reading time and table of contents only for posts.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import ReadingTime from '../components/ReadingTime.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import type { Alternates } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import type { TocItem } from '../lib/toc';
import Base from './Base.astro';

interface Props {
	title: string;
	description?: string;
	pubDate: Date;
	updatedDate?: Date;
	cover?: { src: ImageMetadata; alt: string };
	tags?: string[];
	lang: Lang;
	alternates: Alternates;
	readingMinutes?: number;
	toc?: TocItem[];
}

const {
	title,
	description = title,
	pubDate,
	updatedDate,
	cover,
	tags = [],
	lang,
	alternates,
	readingMinutes,
	toc = [],
} = Astro.props;
const t = useTranslations(lang);
---

<Base title={title} description={description} image={cover?.src} lang={lang} alternates={alternates}>
	<article>
		<header class="mb-8 flex flex-col gap-3">
			{cover && (
				<Image
					src={cover.src}
					alt={cover.alt}
					width={1020}
					height={510}
					class="mb-4 aspect-[2/1] w-full rounded-lg object-cover"
					loading="eager"
				/>
			)}
			<h1 class="text-3xl leading-tight font-bold sm:text-4xl">{title}</h1>
			<p class="flex flex-wrap gap-x-3 text-sm text-muted">
				<FormattedDate date={pubDate} lang={lang} />
				{readingMinutes && <span aria-hidden="true">·</span>}
				{readingMinutes && <ReadingTime minutes={readingMinutes} lang={lang} />}
			</p>
			{updatedDate && (
				<p class="text-sm text-muted italic">
					{t('post.updatedOn')} <FormattedDate date={updatedDate} lang={lang} />
				</p>
			)}
			<TagList tags={tags} lang={lang} />
		</header>
		<div class="mb-8">
			<TableOfContents items={toc} lang={lang} />
		</div>
		<div class="prose">
			<slot />
		</div>
	</article>
</Base>
