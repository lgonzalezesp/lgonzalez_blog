---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import type { Alternates } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import Base from './Base.astro';

interface Props {
	title: string;
	description?: string;
	pubDate: Date;
	updatedDate?: Date;
	cover?: { src: ImageMetadata; alt: string };
	tags?: string[];
	lang: Lang;
	alternates: Alternates;
}

const { title, description = title, pubDate, updatedDate, cover, tags = [], lang, alternates } = Astro.props;
const t = useTranslations(lang);
---

<Base title={title} description={description} image={cover?.src} lang={lang} alternates={alternates}>
	<article>
		<div class="hero-image">
			{cover && <Image width={1020} height={510} src={cover.src} alt={cover.alt} />}
		</div>
		<div class="prose">
			<div class="title">
				<div class="date">
					<FormattedDate date={pubDate} lang={lang} />
					{updatedDate && (
						<div class="last-updated-on">
							{t('post.updatedOn')} <FormattedDate date={updatedDate} lang={lang} />
						</div>
					)}
				</div>
				<h1>{title}</h1>
				{tags.length > 0 && (
					<ul class="tags" aria-label={t('post.tags')}>
						{tags.map((tag) => (
							<li>#{tag}</li>
						))}
					</ul>
				)}
				<hr />
			</div>
			<slot />
		</div>
	</article>
</Base>
<style>
	:global(main) {
		width: calc(100% - 2em);
		max-width: 100%;
		margin: 0;
	}
	.hero-image {
		width: 100%;
	}
	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.prose {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 1em;
		color: rgb(var(--gray-dark));
	}
	.title {
		margin-bottom: 1em;
		padding: 1em 0;
		text-align: center;
		line-height: 1;
	}
	.title h1 {
		margin: 0 0 0.5em 0;
	}
	.date {
		margin-bottom: 0.5em;
		color: rgb(var(--gray));
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5em;
		margin: 0 0 1em;
		padding: 0;
		list-style: none;
		color: rgb(var(--gray));
	}
	.last-updated-on {
		font-style: italic;
	}
</style>
