---
// Posts and notes. Reading time and table of contents only for posts.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Comments from '../components/Comments.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ReadingTime from '../components/ReadingTime.astro';
import ShareButtons from '../components/ShareButtons.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import type { Alternates } from '../i18n/routes';
import type { OgImage } from '../lib/seo';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import type { TocItem } from '../lib/toc';
import Base from './Base.astro';

interface Props {
	title: string;
	description?: string;
	pubDate: Date;
	updatedDate?: Date;
	cover?: { src: ImageMetadata; alt: string };
	tags?: string[];
	lang: Lang;
	alternates: Alternates;
	/** Generated social image, used when there is no cover. */
	generatedImage?: OgImage;
	readingMinutes?: number;
	toc?: TocItem[];
	/** Giscus comments at the end (posts only, not notes). */
	comments?: boolean;
	/** Share buttons at the top and at the end (posts only, not notes). */
	share?: boolean;
}

const {
	title,
	description = title,
	pubDate,
	updatedDate,
	cover,
	tags = [],
	lang,
	alternates,
	generatedImage,
	readingMinutes,
	toc = [],
	comments = false,
	share = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const t = useTranslations(lang);
---

<Base
	title={title}
	description={description}
	image={cover}
	generatedImage={generatedImage}
	article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags }}
	lang={lang}
	alternates={alternates}
>
	<article>
		<header class="mb-8 flex flex-col gap-3">
			{cover && (
				<Image
					src={cover.src}
					alt={cover.alt}
					width={1020}
					height={510}
					class="mb-4 aspect-[2/1] w-full rounded-lg object-cover"
					loading="eager"
				/>
			)}
			<h1 class="text-3xl leading-tight font-bold sm:text-4xl">{title}</h1>
			<p class="flex flex-wrap gap-x-3 text-sm text-muted">
				<FormattedDate date={pubDate} lang={lang} />
				{readingMinutes && <span aria-hidden="true">·</span>}
				{readingMinutes && <ReadingTime minutes={readingMinutes} lang={lang} />}
			</p>
			{updatedDate && (
				<p class="text-sm text-muted italic">
					{t('post.updatedOn')} <FormattedDate date={updatedDate} lang={lang} />
				</p>
			)}
			<TagList tags={tags} lang={lang} />
			{share && <ShareButtons lang={lang} url={canonical} />}
		</header>
		<div class="mb-8">
			<TableOfContents items={toc} lang={lang} />
		</div>
		<div class="prose">
			<slot />
		</div>
		{share && (
			<footer class="mt-12">
				<ShareButtons lang={lang} url={canonical} />
			</footer>
		)}
	</article>
	{comments && <Comments lang={lang} />}
</Base>
